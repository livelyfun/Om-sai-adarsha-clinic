# Om Sai Aadarsha Clinic - Environment Configuration

# Application Environment ('development' | 'production')
APP_ENV="development"
APP_URL="http://localhost:3000"

# Security & Sessions
# Generate with: openssl rand -base64 32
SESSION_SECRET="change-this-to-a-secure-random-secret-in-production-min-32-chars"

# Database Configuration
# When set, connects to PostgreSQL instance (Cloud SQL or external Postgres).
# When unset in development, the app runs using an isolated persistent relational storage layer.
DATABASE_URL=""

# Super Admin One-Time Bootstrap Credentials
# Used by the bootstrap script or endpoint to create the initial Super Admin.
BOOTSTRAP_ADMIN_EMAIL="admin@omsaiclinic.local"
BOOTSTRAP_ADMIN_PASSWORD="ChangeMeImmediately123!"

# Laboratory Report Storage (Private Object Storage)
# Status: NOT CONFIGURED for production.
# In development, files are stored privately in local non-public directory.
# In production, provide GCS or S3 bucket details:
STORAGE_PROVIDER="local" # 'local' | 'gcs' | 's3'
STORAGE_BUCKET_NAME=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""

# Email Provider Configuration (Authentication Emails Only)
# Status: NOT CONFIGURED for production.
# In development, verification and password reset links are printed to the server console.
# In production, provide SMTP or API provider credentials:
EMAIL_PROVIDER="console" # 'console' | 'smtp' | 'resend'
EMAIL_FROM="noreply@omsaiclinic.com"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
